#!/usr/bin/env bash
set -euo pipefail

script_path=$(readlink -f -- "${BASH_SOURCE[0]}")
script_dir=$(cd -- "$(dirname -- "$script_path")" && pwd)
template="$script_dir/page.html"
manifest="$script_dir/assets.json"
local_file=${PHONE_PAGE_LOCAL_FILE:-"$HOME/.agents/local/phone-page.md"}
inbox_file=${PHONE_PAGE_INBOX_FILE:-"$HOME/.agents/local/inbox.md"}
cleanup_path=""

cleanup() {
  [[ -z "$cleanup_path" ]] || rm -rf -- "$cleanup_path"
}
trap cleanup EXIT

die() {
  printf 'phone-page: %s\n' "$1" >&2
  exit 1
}

usage() {
  printf 'usage: phone-page {publish <file> [id]|ask <spec> [id]|read <spec> [id]|delete <id>|inbox|render <spec>|answers <id>|assets <directory>}\n' >&2
  exit 2
}

validate_spec() {
  local spec=$1 expected=${2:-} reason
  jq -e . "$spec" >/dev/null 2>&1 || die "${expected:-question} spec is not valid JSON"
  reason=$(jq -r --arg expected "$expected" -f "$script_dir/validate.jq" "$spec")
  [[ -z "$reason" ]] || die "$reason"
}

render() {
  local spec=$1 expected=${2:-}
  [[ -f "$spec" ]] || die "${expected:-question} spec does not exist: $spec"
  validate_spec "$spec" "$expected"
  jq -jc . "$spec" | jq -Rrs --rawfile template "$template" \
    'gsub("<"; "\\u003c") as $spec | $template | split("__PHONE_PAGE_SPEC__") | join($spec)'
}

store() {
  local store_command
  [[ -f "$local_file" ]] || die "local file not found: $local_file"
  store_command=$(<"$local_file")
  [[ -n "$store_command" && "$store_command" != *$'\n'* ]] || die "local file must contain exactly one store command"
  "$store_command" "$@"
}

inbox_line() {
  printf -- '- %s %s: %s\n' "$(date '+%Y-%m-%d %H:%M')" "$1" "$2" >>"$inbox_file"
}

append_inbox() {
  flock -x 9
  inbox_line "$1" "$2"
}

remove_inbox_id() {
  local inbox_path
  inbox_path=$(mktemp "${inbox_file}.XXXXXX")
  if [[ -f "$inbox_file" ]]; then
    awk -v id="$1" '{ n = split($NF, parts, "/") } parts[n] != id' "$inbox_file" >"$inbox_path"
  fi
  mv -- "$inbox_path" "$inbox_file"
}

replace_inbox() {
  flock -x 9
  remove_inbox_id "$3"
  inbox_line "$1" "$2"
}

delete_inbox() {
  flock -x 9
  remove_inbox_id "$1"
}

prune_inbox() {
  flock -x 9
  local line url id status
  cleanup_path=$(mktemp "${inbox_file}.XXXXXX")
  if [[ -f "$inbox_file" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      url=${line##* }
      id=${url##*/}
      status=0
      (store answers "$id") >/dev/null 2>&1 || status=$?
      case "$status" in
        0|4) ;;
        *) printf '%s\n' "$line" >>"$cleanup_path" ;;
      esac
    done <"$inbox_file"
  fi
  mv -- "$cleanup_path" "$inbox_file"
  cleanup_path=""
  cat "$inbox_file"
}

download_assets() {
  local destination=$1 download_dir name url expected actual
  download_dir=$(mktemp -d "${TMPDIR:-/tmp}/phone-page-assets.XXXXXX")
  cleanup_path=$download_dir
  while IFS=$'\t' read -r name url expected; do
    curl -fsSL "$url" -o "$download_dir/$name"
    actual=$(openssl dgst -sha256 "$download_dir/$name" | awk '{print $NF}')
    [[ "$actual" == "$expected" ]] || die "checksum mismatch for $name"
  done < <(jq -r '.assets[] | [.name, .url, .sha256] | @tsv' "$manifest")
  mkdir -p -- "$destination"
  while IFS= read -r name; do
    install -m 0644 "$download_dir/$name" "$destination/$name"
  done < <(jq -r '.assets[].name' "$manifest")
}

[[ $# -ge 1 ]] || usage
command=$1
shift

case "$command" in
  publish)
    [[ ( $# -eq 1 || $# -eq 2 ) && -f "$1" ]] || usage
    if [[ $# -eq 2 ]]; then
      store update "$2" "$1"
    else
      store publish "$1"
    fi
    ;;
  ask|read)
    [[ $# -eq 1 || $# -eq 2 ]] || usage
    rendered_dir=$(mktemp -d "${TMPDIR:-/tmp}/phone-page.XXXXXX")
    cleanup_path=$rendered_dir
    rendered="$rendered_dir/page.html"
    page_type=question
    [[ "$command" != read ]] || page_type=read
    render "$1" "$page_type" >"$rendered"
    if [[ $# -eq 2 ]]; then
      publish_args=(update "$2" "$rendered")
    else
      publish_args=(publish "$rendered")
      if [[ "$command" == ask && -n "${HERDR_TAB_ID:-}" ]]; then
        publish_args+=("$HERDR_TAB_ID")
      fi
    fi
    published=$(store "${publish_args[@]}")
    if [[ "$command" == ask ]]; then
      url=$(printf '%s\n' "$published" | jq -er '.url | select(type == "string" and length > 0)')
      title=$(jq -r '.title | gsub("[\r\n]"; " ")' "$1")
      mkdir -p -- "$(dirname -- "$inbox_file")"
      if [[ $# -eq 2 ]]; then
        replace_inbox "$title" "$url" "$2" 9>>"$inbox_file.lock"
      else
        append_inbox "$title" "$url" 9>>"$inbox_file.lock"
      fi
    fi
    printf '%s\n' "$published"
    ;;
  delete)
    [[ $# -eq 1 ]] || usage
    status=0
    store delete "$1" || status=$?
    [[ "$status" == 0 || "$status" == 4 ]] || exit "$status"
    mkdir -p -- "$(dirname -- "$inbox_file")"
    delete_inbox "$1" 9>>"$inbox_file.lock"
    exit "$status"
    ;;
  inbox)
    [[ $# -eq 0 ]] || usage
    mkdir -p -- "$(dirname -- "$inbox_file")"
    prune_inbox 9>>"$inbox_file.lock"
    ;;
  render)
    [[ $# -eq 1 ]] || usage
    render "$1"
    ;;
  answers)
    [[ $# -eq 1 ]] || usage
    store answers "$1"
    ;;
  assets)
    [[ $# -eq 1 ]] || usage
    download_assets "$1"
    ;;
  *) usage ;;
esac
